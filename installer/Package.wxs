<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!--
    Paquete de doble ámbito: el asistente pregunta si instalar solo para el usuario actual
    (sin permisos de administrador) o para todos los usuarios (pide permisos al instalar).

    Sin interfaz:  msiexec /i Trazo.msi /qn                          → solo para el usuario actual
                   msiexec /i Trazo.msi /qn MSIINSTALLPERUSER=""     → para todos (desde una consola de administrador)
  -->
  <Package Name="Trazo"
           Manufacturer="Antidecn"
           Version="$(Version)"
           UpgradeCode="9e0df3ca-4a90-4614-a399-1fd8b3c63bd0"
           Scope="perUserOrMachine"
           Language="3082"
           Codepage="1252">

    <SummaryInformation Description="Trazo: capturas de pantalla con anotaciones y OCR" />

    <!--
      Actualización: una versión mayor (por ejemplo 1.0.1 → 1.1.0) desinstala la anterior antes de instalarse.
      Solo detecta la anterior si se instala para los mismos usuarios: por eso el asistente mantiene el tipo
      de instalación y la carpeta de la versión que ya hay (ver PREVIOUSSCOPE).
      La configuración del usuario (%AppData%\Trazo) no se toca al actualizar.
    -->
    <MajorUpgrade DowngradeErrorMessage="Ya hay instalada una versión más reciente de Trazo." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="TrazoIcon" SourceFile="$(AppDir)Trazo.ico" />
    <Property Id="ARPPRODUCTICON" Value="TrazoIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!--
      Trazo usa .NET Framework 4.8, que viene de serie en Windows 11 y en Windows 10 desde la versión 1903.
      Solo en equipos muy desactualizados faltaría (valor "Release" de 528040 = 4.8).
    -->
    <Property Id="NETFRAMEWORK4RELEASE">
      <RegistrySearch Id="NetFramework4Release" Root="HKLM" Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full" Name="Release" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR NETFRAMEWORK4RELEASE &gt;= &quot;#528040&quot;"
            Message="Trazo necesita .NET Framework 4.8, que se incluye en Windows 11 y en Windows 10 actualizado.&#13;&#10;&#13;&#10;Instala las actualizaciones de Windows o descárgalo desde https://dotnet.microsoft.com/download/dotnet-framework/net48 y vuelve a abrir este instalador." />

    <!-- Cierra Trazo si está abierto antes de actualizar o desinstalar -->
    <util:CloseApplication Id="CloseTrazo" Target="Trazo.exe" CloseMessage="yes" TerminateProcess="0" RebootPrompt="no" />

    <!--
      Carpeta por defecto. En instalaciones solo para el usuario, Windows redirige
      "Archivos de programa" a %LocalAppData%\Programs automáticamente.
    -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Trazo" />
    </StandardDirectory>

    <!-- Carpetas de instalaciones anteriores (para actualizar en el mismo sitio) -->
    <Property Id="USERINSTALLFOLDER">
      <RegistrySearch Id="PreviousUserFolder" Root="HKCU" Key="Software\Trazo" Name="InstallFolder" Type="raw" />
    </Property>
    <Property Id="MACHINEINSTALLFOLDER">
      <RegistrySearch Id="PreviousMachineFolder" Root="HKLM" Key="Software\Trazo" Name="InstallFolder" Type="raw" Bitness="always64" />
    </Property>

    <!-- Instalación anterior encontrada (antes de rellenar las carpetas por defecto): "user" o "machine" -->
    <SetProperty Action="DetectPreviousUserInstall" Id="PREVIOUSSCOPE" Value="user" After="AppSearch" Sequence="ui"
                 Condition="USERINSTALLFOLDER" />
    <SetProperty Action="DetectPreviousMachineInstall" Id="PREVIOUSSCOPE" Value="machine" After="DetectPreviousUserInstall" Sequence="ui"
                 Condition="MACHINEINSTALLFOLDER AND NOT USERINSTALLFOLDER" />

    <!-- Opción marcada al abrir el asistente: "solo para mí", salvo que ya estuviera instalado para todos -->
    <Property Id="INSTALLSCOPE" Value="user" />
    <SetProperty Action="SetScopeFromPreviousInstall" Id="INSTALLSCOPE" Value="[PREVIOUSSCOPE]" After="DetectPreviousMachineInstall" Sequence="ui"
                 Condition="PREVIOUSSCOPE" />
    <SetProperty Action="SetDefaultUserFolder" Id="USERINSTALLFOLDER" Value="[LocalAppDataFolder]Programs\Trazo\" After="SetScopeFromPreviousInstall" Sequence="ui"
                 Condition="NOT USERINSTALLFOLDER" />
    <SetProperty Action="SetDefaultMachineFolder" Id="MACHINEINSTALLFOLDER" Value="[%ProgramW6432]\Trazo\" After="SetDefaultUserFolder" Sequence="ui"
                 Condition="NOT MACHINEINSTALLFOLDER" />

    <!-- Sin interfaz (actualizaciones silenciosas): reutiliza la carpeta anterior del ámbito elegido -->
    <SetProperty Action="UsePreviousUserFolder" Id="INSTALLFOLDER" Value="[USERINSTALLFOLDER]" Before="CostFinalize" Sequence="execute"
                 Condition="NOT INSTALLFOLDER AND USERINSTALLFOLDER AND ALLUSERS = 2 AND MSIINSTALLPERUSER = 1" />
    <SetProperty Action="UsePreviousMachineFolder" Id="INSTALLFOLDER" Value="[MACHINEINSTALLFOLDER]" After="UsePreviousUserFolder" Sequence="execute"
                 Condition="NOT INSTALLFOLDER AND MACHINEINSTALLFOLDER AND (ALLUSERS = 1 OR NOT MSIINSTALLPERUSER)" />

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="TrazoExe">
        <File Id="TrazoExe" Source="$(PublishDir)Trazo.exe" />
        <!-- HKMU: HKCU si es solo para el usuario, HKLM si es para todos -->
        <RegistryValue Root="HKMU" Key="Software\Trazo" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      </Component>
      <Files Include="$(PublishDir)**">
        <Exclude Files="$(PublishDir)Trazo.exe" />
      </Files>
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="TrazoShortcut"
                Name="Trazo"
                Description="Capturas de pantalla con anotaciones y OCR"
                Target="[INSTALLFOLDER]Trazo.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="TrazoIcon" />
      <RegistryValue Root="HKMU" Key="Software\Trazo" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!--
      Inicio automático para quien instala. Va en HKCU también en instalaciones para todos,
      para que cada usuario pueda activarlo o quitarlo desde Configuración sin ser administrador.
    -->
    <Component Id="Autostart" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Trazo"
                     Type="string" Value="&quot;[INSTALLFOLDER]Trazo.exe&quot;" KeyPath="yes" />
    </Component>

    <!--
      Avisos de versiones nuevas: la casilla del asistente deja la respuesta ("1" o "0") en HKCU\Software\Trazo,
      valor NotifyUpdates. Trazo la pasa a su configuración al arrancar y borra el valor; desde ahí se cambia
      en Configuración. Solo se escribe si el asistente ha mostrado la pregunta (instalación nueva con interfaz).
    -->
    <Property Id="NOTIFYUPDATES" Secure="yes" />
    <Property Id="UPDATESCHOICE" Secure="yes" />
    <Component Id="UpdatesChoice" Directory="INSTALLFOLDER" Condition="UPDATESCHOICE">
      <RegistryValue Root="HKCU" Key="Software\Trazo" Name="UpdatesAsked" Type="integer" Value="1" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Trazo" Name="NotifyUpdates" Type="string" Value="[UPDATESCHOICE]" />
    </Component>

    <Feature Id="Main" Title="Trazo">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="Autostart" />
      <ComponentRef Id="UpdatesChoice" />
    </Feature>

    <!--
      Al desinstalar: Trazo pregunta si borrar también la configuración del usuario (%AppData%\Trazo).
      No se pregunta al actualizar ni en desinstalaciones silenciosas (/qn): entonces se conserva.
      Va antes de RemoveFiles, mientras Trazo.exe sigue instalado.
    -->
    <CustomAction Id="AskDeleteUserData" FileRef="TrazoExe" ExeCommand="--desinstalar" Execute="immediate" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="AskDeleteUserData" Before="RemoveFiles"
              Condition="REMOVE ~= &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND UILevel &gt; 2" />
    </InstallExecuteSequence>

    <!-- Al terminar: "Abrir Trazo" marcado por defecto (solo en instalaciones y actualizaciones) -->
    <CustomAction Id="LaunchTrazo" FileRef="TrazoExe" ExeCommand="" Execute="immediate" Impersonate="yes" Return="asyncNoWait" />
    <Property Id="LAUNCHTRAZO" Value="1" />

    <UIRef Id="TrazoUI" />
  </Package>

  <!--
    Interfaz con el aspecto de Trazo (fondo oscuro, texto claro, botones grises redondeados).

    Windows Installer no deja cambiar el color de sus controles, así que:
      · El fondo es una imagen y los textos son transparentes, con colores de TextStyle.
      · Los botones son botones con imagen. Las opciones y casillas son pares de botones con imagen
        (elegido / sin elegir) que se muestran u ocultan según la propiedad, y la cambian al pulsarlos.
      · La barra de progreso, el campo de la carpeta y el explorador de carpetas son los de Windows.

    Las imágenes las genera installer\art al compilar (ver installer\README.md), a su tamaño exacto para cada escala
    de pantalla: TRAZOUISCALE vale la altura del texto del sistema redondeada (16 = 100 %, 20, 24, 28 o 32 = 200 %)
    y las imágenes se eligen por nombre, p. ej. Text="TzBtnNext[TRAZOUISCALE]".
    Los tamaños de los controles con imagen deben coincidir con los de installer\art\Program.cs.

    Recorrido:
      Instalación:    Bienvenida → Tipo de instalación → Carpeta → Avisos de actualizaciones → Listo → Progreso → Fin
      Actualización:  Bienvenida → Listo para actualizar → Progreso → Fin (mismo tipo y carpeta que la versión anterior)
      Ya instalado:   ¿Reparar o desinstalar? → Listo → Progreso → Fin
    Desinstalar desde Configuración de Windows usa la ventanita estándar de Windows ("¿Desea desinstalar…?"),
    que no se puede personalizar; Trazo sí muestra su propia pregunta sobre borrar la configuración.
  -->
  <Fragment>
    <!-- Juego de imágenes según la escala de pantalla (TextHeight: 16 px al 100 %); antes del primer diálogo -->
    <Property Id="TRAZOUISCALE" Value="16" />
    <SetProperty Action="TrazoScale20" Id="TRAZOUISCALE" Value="20" Before="AppSearch" Sequence="ui" Condition="TextHeight &gt;= 18" />
    <SetProperty Action="TrazoScale24" Id="TRAZOUISCALE" Value="24" After="TrazoScale20" Sequence="ui" Condition="TextHeight &gt;= 22" />
    <SetProperty Action="TrazoScale28" Id="TRAZOUISCALE" Value="28" After="TrazoScale24" Sequence="ui" Condition="TextHeight &gt;= 26" />
    <SetProperty Action="TrazoScale32" Id="TRAZOUISCALE" Value="32" After="TrazoScale28" Sequence="ui" Condition="TextHeight &gt;= 30" />

    <!-- Carpeta que se elige en el diálogo de la carpeta de destino (los controles de ruta la usan de forma indirecta) -->
    <Property Id="TRAZOINSTALLDIR" Value="INSTALLFOLDER" />

    <!--
      Barra de título con los colores de Trazo (installer/titlebar): un programa pequeño que deja en marcha una copia
      que oscurece cada ventana del asistente al crearse y termina con el instalador. Espera a que esté lista,
      así la primera pantalla ya sale oscura. Si falla, la barra se queda como siempre.
    -->
    <Binary Id="TrazoTitleBar" SourceFile="$(TitleBarExe)" />
    <CustomAction Id="TrazoTitleBar" BinaryRef="TrazoTitleBar" ExeCommand="" Execute="immediate" Return="ignore" />
    <InstallUISequence>
      <Custom Action="TrazoTitleBar" Before="AppSearch" />
    </InstallUISequence>

    <UI Id="TrazoUI">
      <UIRef Id="TrazoArt" />

      <!--
        230 y no 240 como en la app: Windows Installer descarta los colores parecidos al fondo de los diálogos
        de Windows (240, 240, 240) y los pinta en negro.
      -->
      <TextStyle Id="TrazoBody" FaceName="Segoe UI" Size="9" Red="230" Green="230" Blue="230" />
      <TextStyle Id="TrazoSub" FaceName="Segoe UI" Size="9" Red="160" Green="160" Blue="166" />
      <TextStyle Id="TrazoTitle" FaceName="Segoe UI Semibold" Size="12" Red="255" Green="255" Blue="255" />
      <TextStyle Id="TrazoHero" FaceName="Segoe UI Semibold" Size="16" Red="255" Green="255" Blue="255" />
      <Property Id="DefaultUIFont" Value="TrazoBody" />
      <Property Id="ErrorDialog" Value="ErrorDlg" />

      <!--
        Sin pantalla de "Preparando…": salía un instante antes de la bienvenida y parpadeaba.
        El asistente aparece directamente con la pantalla que toca (instalar, actualizar o reparar/desinstalar).
      -->

      <!-- ───────────── Bienvenida (instalación nueva o actualización) ───────────── -->
      <Dialog Id="WelcomeDlg" Width="370" Height="270" Title="Instalación de Trazo">
        <Control Id="Bg" Type="Bitmap" X="0" Y="0" Width="370" Height="270" TabSkip="no" Text="TzBg[TRAZOUISCALE]" />
        <Control Id="Logo" Type="Bitmap" X="20" Y="28" Width="48" Height="48" FixedSize="yes" Text="TzLogoBig[TRAZOUISCALE]" />
        <Control Id="Title" Type="Text" X="20" Y="90" Width="330" Height="22" Transparent="yes" NoPrefix="yes" Hidden="yes" ShowCondition="NOT PREVIOUSSCOPE"
                 Text="{\TrazoHero}Te damos la bienvenida a Trazo" />
        <Control Id="Description" Type="Text" X="20" Y="118" Width="260" Height="60" Transparent="yes" NoPrefix="yes" Hidden="yes" ShowCondition="NOT PREVIOUSSCOPE"
                 Text="{\TrazoBody}Capturas de pantalla con anotaciones, cuentagotas y OCR. Este asistente instalará Trazo [ProductVersion] en tu equipo." />
        <Control Id="UpdateTitle" Type="Text" X="20" Y="90" Width="330" Height="22" Transparent="yes" NoPrefix="yes" Hidden="yes" ShowCondition="PREVIOUSSCOPE"
                 Text="{\TrazoHero}Actualizar Trazo" />
        <Control Id="UpdateDescription" Type="Text" X="20" Y="118" Width="260" Height="60" Transparent="yes" NoPrefix="yes" Hidden="yes" ShowCondition="PREVIOUSSCOPE"
                 Text="{\TrazoBody}Se instalará la versión [ProductVersion] en lugar de la que tienes. Tu configuración se conserva." />
        <Control Id="Hint" Type="Text" X="20" Y="190" Width="260" Height="14" Transparent="yes" NoPrefix="yes" Text="{\TrazoSub}Pulsa Siguiente para continuar." />
        <Control Id="Next" Type="PushButton" X="212" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Default="yes" Text="TzBtnNext[TRAZOUISCALE]" />
        <Control Id="Cancel" Type="PushButton" X="284" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Cancel="yes" Text="TzBtnCancel[TRAZOUISCALE]">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ───────────── Tipo de instalación: dos tarjetas, siempre se ven las dos ───────────── -->
      <Dialog Id="TrazoScopeDlg" Width="370" Height="270" Title="Instalación de Trazo">
        <Control Id="Bg" Type="Bitmap" X="0" Y="0" Width="370" Height="270" TabSkip="no" Text="TzBg[TRAZOUISCALE]" />
        <Control Id="Logo" Type="Bitmap" X="20" Y="18" Width="24" Height="24" FixedSize="yes" Text="TzLogo[TRAZOUISCALE]" />
        <Control Id="Title" Type="Text" X="54" Y="16" Width="296" Height="16" Transparent="yes" NoPrefix="yes" Text="{\TrazoTitle}Tipo de instalación" />
        <Control Id="Description" Type="Text" X="54" Y="32" Width="296" Height="12" Transparent="yes" NoPrefix="yes" Text="{\TrazoSub}¿Para quién quieres instalar Trazo?" />

        <Control Id="UserOn" Type="PushButton" X="20" Y="62" Width="330" Height="52" Bitmap="yes" FixedSize="yes" Text="TzOptUserOn[TRAZOUISCALE]"
                 HideCondition="INSTALLSCOPE &lt;&gt; &quot;user&quot;" ShowCondition="INSTALLSCOPE = &quot;user&quot;">
          <Publish Property="INSTALLSCOPE" Value="user" />
        </Control>
        <Control Id="UserOff" Type="PushButton" X="20" Y="62" Width="330" Height="52" Bitmap="yes" FixedSize="yes" Text="TzOptUserOff[TRAZOUISCALE]"
                 HideCondition="INSTALLSCOPE = &quot;user&quot;" ShowCondition="INSTALLSCOPE &lt;&gt; &quot;user&quot;">
          <Publish Property="INSTALLSCOPE" Value="user" />
        </Control>
        <Control Id="MachineOn" Type="PushButton" X="20" Y="122" Width="330" Height="52" Bitmap="yes" FixedSize="yes" Text="TzOptMachineOn[TRAZOUISCALE]"
                 HideCondition="INSTALLSCOPE &lt;&gt; &quot;machine&quot;" ShowCondition="INSTALLSCOPE = &quot;machine&quot;">
          <Publish Property="INSTALLSCOPE" Value="machine" />
        </Control>
        <Control Id="MachineOff" Type="PushButton" X="20" Y="122" Width="330" Height="52" Bitmap="yes" FixedSize="yes" Text="TzOptMachineOff[TRAZOUISCALE]"
                 HideCondition="INSTALLSCOPE = &quot;machine&quot;" ShowCondition="INSTALLSCOPE &lt;&gt; &quot;machine&quot;">
          <Publish Property="INSTALLSCOPE" Value="machine" />
        </Control>

        <Control Id="Back" Type="PushButton" X="142" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Text="TzBtnBack[TRAZOUISCALE]" />
        <Control Id="Next" Type="PushButton" X="212" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Default="yes" Text="TzBtnNext[TRAZOUISCALE]" />
        <Control Id="Cancel" Type="PushButton" X="284" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Cancel="yes" Text="TzBtnCancel[TRAZOUISCALE]">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ───────────── Carpeta de destino ───────────── -->
      <Dialog Id="InstallDirDlg" Width="370" Height="270" Title="Instalación de Trazo">
        <Control Id="Bg" Type="Bitmap" X="0" Y="0" Width="370" Height="270" TabSkip="no" Text="TzBg[TRAZOUISCALE]" />
        <Control Id="Logo" Type="Bitmap" X="20" Y="18" Width="24" Height="24" FixedSize="yes" Text="TzLogo[TRAZOUISCALE]" />
        <Control Id="Title" Type="Text" X="54" Y="16" Width="296" Height="16" Transparent="yes" NoPrefix="yes" Text="{\TrazoTitle}Carpeta de destino" />
        <Control Id="Description" Type="Text" X="54" Y="32" Width="296" Height="12" Transparent="yes" NoPrefix="yes" Text="{\TrazoSub}Trazo se instalará en esta carpeta." />

        <Control Id="FolderLabel" Type="Text" X="20" Y="66" Width="330" Height="12" Transparent="yes" NoPrefix="yes" Text="{\TrazoBody}Carpeta:" />
        <Control Id="Folder" Type="PathEdit" X="20" Y="80" Width="250" Height="18" Property="TRAZOINSTALLDIR" Indirect="yes" />
        <Control Id="ChangeFolder" Type="PushButton" X="274" Y="80" Width="76" Height="18" Bitmap="yes" FixedSize="yes" Text="TzBtnChange[TRAZOUISCALE]" />
        <Control Id="FolderHint" Type="Text" X="20" Y="106" Width="330" Height="26" Transparent="yes" NoPrefix="yes"
                 Text="{\TrazoSub}Puedes escribir otra ruta o elegirla con Cambiar…" />

        <Control Id="Back" Type="PushButton" X="142" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Text="TzBtnBack[TRAZOUISCALE]" />
        <Control Id="Next" Type="PushButton" X="212" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Default="yes" Text="TzBtnNext[TRAZOUISCALE]" />
        <Control Id="Cancel" Type="PushButton" X="284" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Cancel="yes" Text="TzBtnCancel[TRAZOUISCALE]">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ───────────── Elegir carpeta (explorador de carpetas de Windows Installer) ───────────── -->
      <Dialog Id="BrowseDlg" Width="370" Height="270" Title="Instalación de Trazo">
        <Control Id="Bg" Type="Bitmap" X="0" Y="0" Width="370" Height="270" TabSkip="no" Text="TzBg[TRAZOUISCALE]" />
        <Control Id="Logo" Type="Bitmap" X="20" Y="18" Width="24" Height="24" FixedSize="yes" Text="TzLogo[TRAZOUISCALE]" />
        <Control Id="Title" Type="Text" X="54" Y="16" Width="296" Height="16" Transparent="yes" NoPrefix="yes" Text="{\TrazoTitle}Elegir carpeta" />
        <Control Id="Description" Type="Text" X="54" Y="32" Width="296" Height="12" Transparent="yes" NoPrefix="yes" Text="{\TrazoSub}Busca la carpeta donde instalar Trazo." />

        <Control Id="ComboLabel" Type="Text" X="20" Y="58" Width="160" Height="12" Transparent="yes" NoPrefix="yes" Text="{\TrazoBody}Buscar en:" />
        <Control Id="DirectoryCombo" Type="DirectoryCombo" X="20" Y="72" Width="170" Height="80" Property="_BrowseProperty" Indirect="yes" Fixed="yes" Remote="yes">
          <Subscribe Event="IgnoreChange" Attribute="IgnoreChange" />
        </Control>
        <Control Id="Up" Type="PushButton" X="194" Y="72" Width="76" Height="18" Bitmap="yes" FixedSize="yes" Text="TzBtnUp[TRAZOUISCALE]">
          <Publish Event="DirectoryListUp" Value="0" />
        </Control>
        <Control Id="NewFolder" Type="PushButton" X="274" Y="72" Width="76" Height="18" Bitmap="yes" FixedSize="yes" Text="TzBtnNewFolder[TRAZOUISCALE]">
          <Publish Event="DirectoryListNew" Value="0" />
        </Control>
        <Control Id="DirectoryList" Type="DirectoryList" X="20" Y="96" Width="330" Height="98" Property="_BrowseProperty" Indirect="yes" Sunken="yes" TabSkip="no" />
        <Control Id="PathLabel" Type="Text" X="20" Y="200" Width="60" Height="12" Transparent="yes" NoPrefix="yes" Text="{\TrazoBody}Carpeta:" />
        <Control Id="PathEdit" Type="PathEdit" X="62" Y="198" Width="288" Height="18" Property="_BrowseProperty" Indirect="yes" />

        <Control Id="OK" Type="PushButton" X="212" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Default="yes" Text="TzBtnOk[TRAZOUISCALE]">
          <Publish Event="SetTargetPath" Value="[_BrowseProperty]" Order="1" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="284" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Cancel="yes" Text="TzBtnCancel[TRAZOUISCALE]">
          <Publish Event="Reset" Value="0" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
      </Dialog>

      <!-- ───────────── Avisos de versiones nuevas: casilla desmarcada por defecto ───────────── -->
      <Dialog Id="TrazoUpdatesDlg" Width="370" Height="270" Title="Instalación de Trazo">
        <Control Id="Bg" Type="Bitmap" X="0" Y="0" Width="370" Height="270" TabSkip="no" Text="TzBg[TRAZOUISCALE]" />
        <Control Id="Logo" Type="Bitmap" X="20" Y="18" Width="24" Height="24" FixedSize="yes" Text="TzLogo[TRAZOUISCALE]" />
        <Control Id="Title" Type="Text" X="54" Y="16" Width="296" Height="16" Transparent="yes" NoPrefix="yes" Text="{\TrazoTitle}Avisos de actualizaciones" />
        <Control Id="Description" Type="Text" X="54" Y="32" Width="296" Height="12" Transparent="yes" NoPrefix="yes" Text="{\TrazoSub}¿Quieres saber cuándo hay una versión nueva de Trazo?" />

        <Control Id="NotifyOn" Type="PushButton" X="20" Y="64" Width="300" Height="16" Bitmap="yes" FixedSize="yes" Text="TzChkUpdatesOn[TRAZOUISCALE]"
                 HideCondition="NOT NOTIFYUPDATES" ShowCondition="NOTIFYUPDATES">
          <Publish Property="NOTIFYUPDATES" Value="{}" />
        </Control>
        <Control Id="NotifyOff" Type="PushButton" X="20" Y="64" Width="300" Height="16" Bitmap="yes" FixedSize="yes" Text="TzChkUpdatesOff[TRAZOUISCALE]"
                 HideCondition="NOTIFYUPDATES" ShowCondition="NOT NOTIFYUPDATES">
          <Publish Property="NOTIFYUPDATES" Value="1" />
        </Control>
        <Control Id="NotifyDescription" Type="Text" X="41" Y="84" Width="305" Height="40" Transparent="yes" NoPrefix="yes"
                 Text="{\TrazoSub}Trazo lo comprobará como mucho una vez al día y te mostrará un aviso. Nunca se actualiza solo: desde el aviso puedes ver la versión nueva y decidir si instalarla." />
        <Control Id="SettingsNote" Type="Text" X="20" Y="140" Width="330" Height="26" Transparent="yes" NoPrefix="yes"
                 Text="{\TrazoSub}Puedes cambiarlo cuando quieras en la configuración de Trazo (doble clic en su icono de la bandeja)." />

        <Control Id="Back" Type="PushButton" X="142" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Text="TzBtnBack[TRAZOUISCALE]" />
        <Control Id="Next" Type="PushButton" X="212" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Default="yes" Text="TzBtnNext[TRAZOUISCALE]" />
        <Control Id="Cancel" Type="PushButton" X="284" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Cancel="yes" Text="TzBtnCancel[TRAZOUISCALE]">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ───────────── Ya instalado: reparar o desinstalar ───────────── -->
      <Dialog Id="MaintenanceTypeDlg" Width="370" Height="270" Title="Trazo">
        <Control Id="Bg" Type="Bitmap" X="0" Y="0" Width="370" Height="270" TabSkip="no" Text="TzBg[TRAZOUISCALE]" />
        <Control Id="Logo" Type="Bitmap" X="20" Y="18" Width="24" Height="24" FixedSize="yes" Text="TzLogo[TRAZOUISCALE]" />
        <Control Id="Title" Type="Text" X="54" Y="16" Width="296" Height="16" Transparent="yes" NoPrefix="yes" Text="{\TrazoTitle}Trazo ya está instalado" />
        <Control Id="Description" Type="Text" X="54" Y="32" Width="296" Height="12" Transparent="yes" NoPrefix="yes" Text="{\TrazoSub}¿Qué quieres hacer?" />

        <Control Id="RepairButton" Type="PushButton" X="20" Y="62" Width="330" Height="52" Bitmap="yes" FixedSize="yes" Text="TzActRepair[TRAZOUISCALE]">
          <Publish Property="TRAZOMODE" Value="Repair" Order="1" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="2" />
        </Control>
        <Control Id="RemoveButton" Type="PushButton" X="20" Y="122" Width="330" Height="52" Bitmap="yes" FixedSize="yes" Text="TzActRemove[TRAZOUISCALE]">
          <Publish Property="TRAZOMODE" Value="Remove" Order="1" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="2" />
        </Control>

        <Control Id="Cancel" Type="PushButton" X="284" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Default="yes" Cancel="yes" Text="TzBtnCancel[TRAZOUISCALE]">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ───────────── Listo: instalar, actualizar, reparar o desinstalar ───────────── -->
      <Dialog Id="VerifyReadyDlg" Width="370" Height="270" Title="Instalación de Trazo" TrackDiskSpace="yes">
        <Control Id="Bg" Type="Bitmap" X="0" Y="0" Width="370" Height="270" TabSkip="no" Text="TzBg[TRAZOUISCALE]" />
        <Control Id="Logo" Type="Bitmap" X="20" Y="18" Width="24" Height="24" FixedSize="yes" Text="TzLogo[TRAZOUISCALE]" />

        <Control Id="InstallTitle" Type="Text" X="54" Y="16" Width="296" Height="16" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="NOT Installed AND NOT PREVIOUSSCOPE" Text="{\TrazoTitle}Listo para instalar" />
        <Control Id="InstallDescription" Type="Text" X="54" Y="32" Width="296" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="NOT Installed AND NOT PREVIOUSSCOPE" Text="{\TrazoSub}Pulsa Instalar para empezar." />
        <Control Id="InstallFolderLabel" Type="Text" X="20" Y="66" Width="330" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="NOT Installed" Text="{\TrazoSub}Carpeta" />
        <Control Id="InstallFolder" Type="Text" X="20" Y="80" Width="330" Height="24" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="NOT Installed" Text="{\TrazoBody}[INSTALLFOLDER]" />
        <Control Id="ScopeLabel" Type="Text" X="20" Y="110" Width="330" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="NOT Installed" Text="{\TrazoSub}Para" />
        <Control Id="ScopeUser" Type="Text" X="20" Y="124" Width="330" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="NOT Installed AND MSIINSTALLPERUSER = 1" Text="{\TrazoBody}Solo tu usuario" />
        <Control Id="ScopeMachine" Type="Text" X="20" Y="124" Width="330" Height="24" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="NOT Installed AND MSIINSTALLPERUSER &lt;&gt; 1" Text="{\TrazoBody}Todos los usuarios de este equipo (Windows pedirá permisos de administrador)" />

        <Control Id="UpdateTitle" Type="Text" X="54" Y="16" Width="296" Height="16" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="NOT Installed AND PREVIOUSSCOPE" Text="{\TrazoTitle}Listo para actualizar" />
        <Control Id="UpdateDescription" Type="Text" X="54" Y="32" Width="296" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="NOT Installed AND PREVIOUSSCOPE" Text="{\TrazoSub}Pulsa Actualizar para instalar la versión [ProductVersion]." />
        <Control Id="UpdateNote" Type="Text" X="20" Y="156" Width="330" Height="26" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="NOT Installed AND PREVIOUSSCOPE" Text="{\TrazoSub}Si Trazo está abierto, se cerrará un momento. Tu configuración se conserva." />

        <Control Id="RepairTitle" Type="Text" X="54" Y="16" Width="296" Height="16" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="Installed AND TRAZOMODE = &quot;Repair&quot;" Text="{\TrazoTitle}Listo para reparar" />
        <Control Id="RepairDescription" Type="Text" X="54" Y="32" Width="296" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="Installed AND TRAZOMODE = &quot;Repair&quot;" Text="{\TrazoSub}Pulsa Reparar para empezar." />
        <Control Id="RepairText" Type="Text" X="20" Y="66" Width="330" Height="40" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="Installed AND TRAZOMODE = &quot;Repair&quot;"
                 Text="{\TrazoBody}Se volverán a copiar los archivos de Trazo y su acceso en el menú Inicio. Tu configuración no se toca." />

        <Control Id="RemoveTitle" Type="Text" X="54" Y="16" Width="296" Height="16" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="Installed AND TRAZOMODE = &quot;Remove&quot;" Text="{\TrazoTitle}Listo para desinstalar" />
        <Control Id="RemoveDescription" Type="Text" X="54" Y="32" Width="296" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="Installed AND TRAZOMODE = &quot;Remove&quot;" Text="{\TrazoSub}Pulsa Desinstalar para quitar Trazo." />
        <Control Id="RemoveText" Type="Text" X="20" Y="66" Width="330" Height="40" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="Installed AND TRAZOMODE = &quot;Remove&quot;"
                 Text="{\TrazoBody}Se quitará Trazo de este equipo. Antes, Trazo te preguntará si quieres borrar también tu configuración." />

        <Control Id="Back" Type="PushButton" X="142" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Text="TzBtnBack[TRAZOUISCALE]" />
        <Control Id="Install" Type="PushButton" X="212" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Default="yes" Hidden="yes"
                 ShowCondition="NOT Installed AND NOT PREVIOUSSCOPE" Text="TzBtnInstall[TRAZOUISCALE]">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Update" Type="PushButton" X="212" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Hidden="yes"
                 ShowCondition="NOT Installed AND PREVIOUSSCOPE" Text="TzBtnUpdate[TRAZOUISCALE]">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Repair" Type="PushButton" X="212" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Hidden="yes"
                 ShowCondition="Installed AND TRAZOMODE = &quot;Repair&quot;" Text="TzBtnRepair[TRAZOUISCALE]">
          <Publish Event="ReinstallMode" Value="ecmus" Order="1" />
          <Publish Event="Reinstall" Value="All" Order="2" />
          <Publish Event="EndDialog" Value="Return" Order="3" />
        </Control>
        <Control Id="Remove" Type="PushButton" X="212" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Hidden="yes"
                 ShowCondition="Installed AND TRAZOMODE = &quot;Remove&quot;" Text="TzBtnRemove[TRAZOUISCALE]">
          <Publish Event="Remove" Value="All" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="284" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Cancel="yes" Text="TzBtnCancel[TRAZOUISCALE]">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ───────────── Progreso ───────────── -->
      <Dialog Id="ProgressDlg" Width="370" Height="270" Title="Instalación de Trazo" Modeless="yes">
        <Control Id="Bg" Type="Bitmap" X="0" Y="0" Width="370" Height="270" TabSkip="no" Text="TzBg[TRAZOUISCALE]" />
        <Control Id="Logo" Type="Bitmap" X="20" Y="18" Width="24" Height="24" FixedSize="yes" Text="TzLogo[TRAZOUISCALE]" />
        <Control Id="InstallTitle" Type="Text" X="54" Y="16" Width="296" Height="16" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="NOT Installed AND NOT PREVIOUSSCOPE" Text="{\TrazoTitle}Instalando Trazo" />
        <Control Id="UpdateTitle" Type="Text" X="54" Y="16" Width="296" Height="16" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="NOT Installed AND PREVIOUSSCOPE" Text="{\TrazoTitle}Actualizando Trazo" />
        <Control Id="RepairTitle" Type="Text" X="54" Y="16" Width="296" Height="16" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="Installed AND TRAZOMODE = &quot;Repair&quot;" Text="{\TrazoTitle}Reparando Trazo" />
        <Control Id="RemoveTitle" Type="Text" X="54" Y="16" Width="296" Height="16" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="Installed AND TRAZOMODE &lt;&gt; &quot;Repair&quot;" Text="{\TrazoTitle}Desinstalando Trazo" />
        <Control Id="Description" Type="Text" X="54" Y="32" Width="296" Height="12" Transparent="yes" NoPrefix="yes" Text="{\TrazoSub}Un momento, solo tarda unos segundos." />
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="80" Width="330" Height="6" ProgressBlocks="yes" Text="Progreso">
          <Subscribe Event="SetProgress" Attribute="Progress" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="284" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Default="yes" Cancel="yes" Text="TzBtnCancel[TRAZOUISCALE]">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ───────────── Fin ───────────── -->
      <Dialog Id="ExitDialog" Width="370" Height="270" Title="Instalación de Trazo">
        <Control Id="Bg" Type="Bitmap" X="0" Y="0" Width="370" Height="270" TabSkip="no" Text="TzBg[TRAZOUISCALE]" />
        <Control Id="Logo" Type="Bitmap" X="20" Y="28" Width="48" Height="48" FixedSize="yes" Text="TzLogoBig[TRAZOUISCALE]" />

        <Control Id="InstallTitle" Type="Text" X="20" Y="90" Width="330" Height="22" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="NOT Installed AND NOT PREVIOUSSCOPE" Text="{\TrazoHero}Trazo está instalado" />
        <Control Id="InstallText" Type="Text" X="20" Y="118" Width="260" Height="50" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="NOT Installed AND NOT PREVIOUSSCOPE"
                 Text="{\TrazoBody}Lo encontrarás en la bandeja del sistema y en el menú Inicio. Pulsa Ctrl + Alt + S para hacer una captura; el atajo se puede cambiar en la configuración." />
        <Control Id="UpdateTitle" Type="Text" X="20" Y="90" Width="330" Height="22" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="NOT Installed AND PREVIOUSSCOPE" Text="{\TrazoHero}Trazo está actualizado" />
        <Control Id="UpdateText" Type="Text" X="20" Y="118" Width="260" Height="50" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="NOT Installed AND PREVIOUSSCOPE" Text="{\TrazoBody}Ya tienes la versión [ProductVersion], con tu configuración de siempre." />
        <Control Id="RepairTitle" Type="Text" X="20" Y="90" Width="330" Height="22" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="Installed AND TRAZOMODE = &quot;Repair&quot;" Text="{\TrazoHero}Trazo se ha reparado" />
        <Control Id="RepairText" Type="Text" X="20" Y="118" Width="260" Height="50" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="Installed AND TRAZOMODE = &quot;Repair&quot;" Text="{\TrazoBody}Los archivos de Trazo vuelven a estar completos." />
        <Control Id="RemoveTitle" Type="Text" X="20" Y="90" Width="330" Height="22" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="Installed AND TRAZOMODE &lt;&gt; &quot;Repair&quot;" Text="{\TrazoHero}Trazo se ha desinstalado" />
        <Control Id="RemoveText" Type="Text" X="20" Y="118" Width="260" Height="50" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 ShowCondition="Installed AND TRAZOMODE &lt;&gt; &quot;Repair&quot;" Text="{\TrazoBody}Gracias por usar Trazo." />

        <Control Id="LaunchOn" Type="PushButton" X="20" Y="190" Width="120" Height="16" Bitmap="yes" FixedSize="yes" Hidden="yes" Text="TzChkLaunchOn[TRAZOUISCALE]"
                 HideCondition="Installed OR NOT LAUNCHTRAZO" ShowCondition="NOT Installed AND LAUNCHTRAZO">
          <Publish Property="LAUNCHTRAZO" Value="{}" />
        </Control>
        <Control Id="LaunchOff" Type="PushButton" X="20" Y="190" Width="120" Height="16" Bitmap="yes" FixedSize="yes" Hidden="yes" Text="TzChkLaunchOff[TRAZOUISCALE]"
                 HideCondition="Installed OR LAUNCHTRAZO" ShowCondition="NOT Installed AND NOT LAUNCHTRAZO">
          <Publish Property="LAUNCHTRAZO" Value="1" />
        </Control>

        <Control Id="Finish" Type="PushButton" X="284" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Default="yes" Cancel="yes" Text="TzBtnFinish[TRAZOUISCALE]">
          <Publish Event="DoAction" Value="LaunchTrazo" Order="1" Condition="LAUNCHTRAZO = 1 AND NOT Installed" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
      </Dialog>

      <Dialog Id="UserExit" Width="370" Height="270" Title="Instalación de Trazo">
        <Control Id="Bg" Type="Bitmap" X="0" Y="0" Width="370" Height="270" TabSkip="no" Text="TzBg[TRAZOUISCALE]" />
        <Control Id="Logo" Type="Bitmap" X="20" Y="28" Width="48" Height="48" FixedSize="yes" Text="TzLogoBig[TRAZOUISCALE]" />
        <Control Id="Title" Type="Text" X="20" Y="90" Width="330" Height="22" Transparent="yes" NoPrefix="yes" Text="{\TrazoHero}Cancelado" />
        <Control Id="Description" Type="Text" X="20" Y="118" Width="260" Height="50" Transparent="yes" NoPrefix="yes"
                 Text="{\TrazoBody}No se ha cambiado nada en tu equipo. Puedes volver a abrir el instalador cuando quieras." />
        <Control Id="Finish" Type="PushButton" X="284" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Default="yes" Cancel="yes" Text="TzBtnFinish[TRAZOUISCALE]">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="FatalError" Width="370" Height="270" Title="Instalación de Trazo">
        <Control Id="Bg" Type="Bitmap" X="0" Y="0" Width="370" Height="270" TabSkip="no" Text="TzBg[TRAZOUISCALE]" />
        <Control Id="Logo" Type="Bitmap" X="20" Y="28" Width="48" Height="48" FixedSize="yes" Text="TzLogoBig[TRAZOUISCALE]" />
        <Control Id="Title" Type="Text" X="20" Y="90" Width="330" Height="22" Transparent="yes" NoPrefix="yes" Text="{\TrazoHero}No se ha podido terminar" />
        <Control Id="Description" Type="Text" X="20" Y="118" Width="260" Height="60" Transparent="yes" NoPrefix="yes"
                 Text="{\TrazoBody}Ha habido un error y no se ha cambiado nada en tu equipo. Vuelve a intentarlo; si sigue pasando, descarga el instalador de nuevo." />
        <Control Id="Finish" Type="PushButton" X="284" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Default="yes" Cancel="yes" Text="TzBtnFinish[TRAZOUISCALE]">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <!-- Instalación interrumpida que Windows reanuda -->
      <Dialog Id="ResumeDlg" Width="370" Height="270" Title="Instalación de Trazo">
        <Control Id="Bg" Type="Bitmap" X="0" Y="0" Width="370" Height="270" TabSkip="no" Text="TzBg[TRAZOUISCALE]" />
        <Control Id="Logo" Type="Bitmap" X="20" Y="28" Width="48" Height="48" FixedSize="yes" Text="TzLogoBig[TRAZOUISCALE]" />
        <Control Id="Title" Type="Text" X="20" Y="90" Width="330" Height="22" Transparent="yes" NoPrefix="yes" Text="{\TrazoHero}Continuar la instalación" />
        <Control Id="Description" Type="Text" X="20" Y="118" Width="260" Height="50" Transparent="yes" NoPrefix="yes"
                 Text="{\TrazoBody}La instalación de Trazo se quedó a medias. Pulsa Instalar para terminarla." />
        <Control Id="Install" Type="PushButton" X="212" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Default="yes" Text="TzBtnInstall[TRAZOUISCALE]">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="284" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Cancel="yes" Text="TzBtnCancel[TRAZOUISCALE]">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ───────────── Diálogos pequeños ───────────── -->
      <Dialog Id="CancelDlg" Width="270" Height="100" Title="Instalación de Trazo">
        <Control Id="Bg" Type="Bitmap" X="0" Y="0" Width="270" Height="100" TabSkip="no" Text="TzBgSmall[TRAZOUISCALE]" />
        <Control Id="Text" Type="Text" X="20" Y="16" Width="230" Height="40" Transparent="yes" NoPrefix="yes" Text="{\TrazoBody}¿Seguro que quieres cancelar?" />
        <Control Id="Yes" Type="PushButton" X="114" Y="72" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Text="TzBtnYes[TRAZOUISCALE]">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="No" Type="PushButton" X="184" Y="72" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Default="yes" Cancel="yes" Text="TzBtnNo[TRAZOUISCALE]">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <!-- Errores: Windows Installer pone el texto y deja visibles solo los botones que hacen falta -->
      <Dialog Id="ErrorDlg" Width="270" Height="100" Title="Instalación de Trazo" ErrorDialog="yes">
        <Control Id="ErrorText" Type="Text" X="20" Y="12" Width="230" Height="48" Transparent="yes" NoPrefix="yes" TabSkip="no" Text="{\TrazoBody}Error" />
        <Control Id="Bg" Type="Bitmap" X="0" Y="0" Width="270" Height="100" TabSkip="no" Text="TzBgSmall[TRAZOUISCALE]" />
        <Control Id="Y" Type="PushButton" X="184" Y="72" Width="66" Height="20" Bitmap="yes" FixedSize="yes" TabSkip="yes" Text="TzBtnYes[TRAZOUISCALE]">
          <Publish Event="EndDialog" Value="ErrorYes" />
        </Control>
        <Control Id="A" Type="PushButton" X="184" Y="72" Width="66" Height="20" Bitmap="yes" FixedSize="yes" TabSkip="yes" Text="TzBtnAbort[TRAZOUISCALE]">
          <Publish Event="EndDialog" Value="ErrorAbort" />
        </Control>
        <Control Id="C" Type="PushButton" X="184" Y="72" Width="66" Height="20" Bitmap="yes" FixedSize="yes" TabSkip="yes" Text="TzBtnCancel[TRAZOUISCALE]">
          <Publish Event="EndDialog" Value="ErrorCancel" />
        </Control>
        <Control Id="I" Type="PushButton" X="184" Y="72" Width="66" Height="20" Bitmap="yes" FixedSize="yes" TabSkip="yes" Text="TzBtnIgnore[TRAZOUISCALE]">
          <Publish Event="EndDialog" Value="ErrorIgnore" />
        </Control>
        <Control Id="N" Type="PushButton" X="184" Y="72" Width="66" Height="20" Bitmap="yes" FixedSize="yes" TabSkip="yes" Text="TzBtnNo[TRAZOUISCALE]">
          <Publish Event="EndDialog" Value="ErrorNo" />
        </Control>
        <Control Id="O" Type="PushButton" X="184" Y="72" Width="66" Height="20" Bitmap="yes" FixedSize="yes" TabSkip="yes" Text="TzBtnOk[TRAZOUISCALE]">
          <Publish Event="EndDialog" Value="ErrorOk" />
        </Control>
        <Control Id="R" Type="PushButton" X="184" Y="72" Width="66" Height="20" Bitmap="yes" FixedSize="yes" TabSkip="yes" Text="TzBtnRetry[TRAZOUISCALE]">
          <Publish Event="EndDialog" Value="ErrorRetry" />
        </Control>
      </Dialog>

      <!-- Archivos en uso (Trazo se cierra solo antes de actualizar; esto queda por si otro programa los tiene abiertos) -->
      <Dialog Id="MsiRMFilesInUse" Width="370" Height="270" Title="Instalación de Trazo">
        <Control Id="Bg" Type="Bitmap" X="0" Y="0" Width="370" Height="270" TabSkip="no" Text="TzBg[TRAZOUISCALE]" />
        <Control Id="Logo" Type="Bitmap" X="20" Y="18" Width="24" Height="24" FixedSize="yes" Text="TzLogo[TRAZOUISCALE]" />
        <Control Id="Title" Type="Text" X="54" Y="16" Width="296" Height="16" Transparent="yes" NoPrefix="yes" Text="{\TrazoTitle}Hay programas abiertos" />
        <Control Id="Description" Type="Text" X="54" Y="32" Width="296" Height="12" Transparent="yes" NoPrefix="yes" Text="{\TrazoSub}Se cerrarán para poder continuar." />
        <Control Id="List" Type="ListBox" X="20" Y="62" Width="330" Height="150" Property="FileInUseProcess" Sunken="yes" TabSkip="yes" />
        <Control Id="OK" Type="PushButton" X="212" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Default="yes" Text="TzBtnOk[TRAZOUISCALE]">
          <Publish Event="RMShutdownAndRestart" Value="0" Order="1" />
          <Publish Event="EndDialog" Value="Return" Order="2" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="284" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Cancel="yes" Text="TzBtnCancel[TRAZOUISCALE]">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <Dialog Id="FilesInUse" Width="370" Height="270" Title="Instalación de Trazo" KeepModeless="yes">
        <Control Id="Bg" Type="Bitmap" X="0" Y="0" Width="370" Height="270" TabSkip="no" Text="TzBg[TRAZOUISCALE]" />
        <Control Id="Logo" Type="Bitmap" X="20" Y="18" Width="24" Height="24" FixedSize="yes" Text="TzLogo[TRAZOUISCALE]" />
        <Control Id="Title" Type="Text" X="54" Y="16" Width="296" Height="16" Transparent="yes" NoPrefix="yes" Text="{\TrazoTitle}Hay programas abiertos" />
        <Control Id="Description" Type="Text" X="54" Y="32" Width="296" Height="12" Transparent="yes" NoPrefix="yes" Text="{\TrazoSub}Ciérralos y pulsa Reintentar." />
        <Control Id="List" Type="ListBox" X="20" Y="62" Width="330" Height="150" Property="FileInUseProcess" Sunken="yes" TabSkip="yes" />
        <Control Id="Exit" Type="PushButton" X="72" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Cancel="yes" Text="TzBtnExit[TRAZOUISCALE]">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
        <Control Id="Ignore" Type="PushButton" X="142" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Text="TzBtnIgnore[TRAZOUISCALE]">
          <Publish Event="EndDialog" Value="Ignore" />
        </Control>
        <Control Id="Retry" Type="PushButton" X="212" Y="240" Width="66" Height="20" Bitmap="yes" FixedSize="yes" Default="yes" Text="TzBtnRetry[TRAZOUISCALE]">
          <Publish Event="EndDialog" Value="Retry" />
        </Control>
      </Dialog>

      <!-- ───────────── Secuencia ───────────── -->
      <InstallUISequence>
        <Show Dialog="WelcomeDlg" Before="ProgressDlg" Condition="NOT Installed" />
        <Show Dialog="ResumeDlg" Before="ProgressDlg" Condition="Installed AND (RESUME OR Preselected)" />
        <Show Dialog="MaintenanceTypeDlg" Before="ProgressDlg" Condition="Installed AND NOT RESUME AND NOT Preselected" />
        <Show Dialog="ProgressDlg" Before="ExecuteAction" />
        <Show Dialog="ExitDialog" OnExit="success" />
        <Show Dialog="UserExit" OnExit="cancel" />
        <Show Dialog="FatalError" OnExit="error" />
      </InstallUISequence>
      <!-- Instalación administrativa (msiexec /a): solo progreso y pantallas finales -->
      <AdminUISequence>
        <Show Dialog="ProgressDlg" Before="ExecuteAction" />
        <Show Dialog="ExitDialog" OnExit="success" />
        <Show Dialog="UserExit" OnExit="cancel" />
        <Show Dialog="FatalError" OnExit="error" />
      </AdminUISequence>

      <!-- Bienvenida: instalación nueva → tipo de instalación -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="TrazoScopeDlg" Order="6" Condition="NOT Installed AND NOT PREVIOUSSCOPE" />

      <!-- Actualización: mismo tipo de instalación y misma carpeta que la versión anterior, directo a "Listo para actualizar" -->
      <Publish Dialog="WelcomeDlg" Control="Next" Property="MSIINSTALLPERUSER" Value="1" Order="1" Condition="NOT Installed AND PREVIOUSSCOPE = &quot;user&quot;" />
      <Publish Dialog="WelcomeDlg" Control="Next" Property="MSIINSTALLPERUSER" Value="{}" Order="2" Condition="NOT Installed AND PREVIOUSSCOPE = &quot;machine&quot;" />
      <Publish Dialog="WelcomeDlg" Control="Next" Property="INSTALLFOLDER" Value="[USERINSTALLFOLDER]" Order="3" Condition="NOT Installed AND PREVIOUSSCOPE = &quot;user&quot;" />
      <Publish Dialog="WelcomeDlg" Control="Next" Property="INSTALLFOLDER" Value="[MACHINEINSTALLFOLDER]" Order="4" Condition="NOT Installed AND PREVIOUSSCOPE = &quot;machine&quot;" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="5" Condition="NOT Installed AND PREVIOUSSCOPE" />

      <!-- Al elegir el tipo se fija el ámbito y se propone la carpeta correspondiente -->
      <Publish Dialog="TrazoScopeDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="TrazoScopeDlg" Control="Next" Property="MSIINSTALLPERUSER" Value="1" Order="1" Condition="INSTALLSCOPE = &quot;user&quot;" />
      <Publish Dialog="TrazoScopeDlg" Control="Next" Property="MSIINSTALLPERUSER" Value="{}" Order="2" Condition="INSTALLSCOPE = &quot;machine&quot;" />
      <Publish Dialog="TrazoScopeDlg" Control="Next" Property="INSTALLFOLDER" Value="[USERINSTALLFOLDER]" Order="3" Condition="INSTALLSCOPE = &quot;user&quot;" />
      <Publish Dialog="TrazoScopeDlg" Control="Next" Property="INSTALLFOLDER" Value="[MACHINEINSTALLFOLDER]" Order="4" Condition="INSTALLSCOPE = &quot;machine&quot;" />
      <Publish Dialog="TrazoScopeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="5" />

      <!--
        Carpeta: "Cambiar…" abre el explorador de carpetas. SetTargetPath comprueba la ruta: si no vale,
        Windows Installer lo dice con el diálogo de error y el asistente se queda en la misma pantalla.
      -->
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="TrazoScopeDlg" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[TRAZOINSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="TrazoUpdatesDlg" Order="2" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[TRAZOINSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="EndDialog" Value="Return" Order="2" />

      <!-- La respuesta se guarda como "1" o "0" (la casilla desmarcada deja la propiedad vacía) -->
      <Publish Dialog="TrazoUpdatesDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" />
      <Publish Dialog="TrazoUpdatesDlg" Control="Next" Property="UPDATESCHOICE" Value="1" Order="1" Condition="NOTIFYUPDATES" />
      <Publish Dialog="TrazoUpdatesDlg" Control="Next" Property="UPDATESCHOICE" Value="0" Order="2" Condition="NOT NOTIFYUPDATES" />
      <Publish Dialog="TrazoUpdatesDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="3" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="TrazoUpdatesDlg" Order="1" Condition="NOT Installed AND NOT PREVIOUSSCOPE" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="3" Condition="NOT Installed AND PREVIOUSSCOPE" />
    </UI>
  </Fragment>
</Wix>
