<Project Sdk="WixToolset.Sdk/5.0.2">

  <!--
    Genera installer\bin\Release\Trazo-<versión>.msi

      dotnet build installer\Trazo.Installer.wixproj -c Release

    Antes de empaquetar publica la aplicación (Release, .NET Framework 4.8, que ya viene con Windows).
  -->

  <PropertyGroup>
    <AppVersion>1.5.2</AppVersion>
    <OutputName>Trazo-$(AppVersion)</OutputName>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>es-ES</Cultures>
    <AppPublishDir>$(MSBuildThisFileDirectory)obj\publish\</AppPublishDir>
    <TrazoTitleBarDir>$(MSBuildThisFileDirectory)obj\titlebar\</TrazoTitleBarDir>
    <DefineConstants>Version=$(AppVersion);PublishDir=$(AppPublishDir);AppDir=$(MSBuildThisFileDirectory)..\;TitleBarExe=$(TrazoTitleBarDir)TrazoTitleBar.exe</DefineConstants>
    <!--
      Paquete de doble ámbito (usuario o equipo): estas comprobaciones suponen un único ámbito fijo
      y dan falsos avisos con HKMU, la carpeta redirigida y el inicio automático en HKCU.
      ICE105: la acción de WiX que cierra Trazo es "sin suplantación"; en modo usuario corre igualmente como el usuario.
    -->
    <SuppressIces>ICE38;ICE57;ICE64;ICE91;ICE105</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

  <!--
    Imágenes del asistente con el aspecto de Trazo: las genera installer\art (C#, .NET 10) en obj\art,
    junto con TrazoArt.wxs, que las mete en el .msi. Solo se regeneran si cambia el generador o el símbolo.
    Ver installer\README.md.
  -->
  <PropertyGroup>
    <TrazoArtDir>$(MSBuildThisFileDirectory)obj\art\</TrazoArtDir>
  </PropertyGroup>
  <ItemGroup>
    <TrazoArtInput Include="art\*.cs;art\*.csproj;..\assets\Trazo-simbolo.ai" />
    <Compile Include="$(TrazoArtDir)TrazoArt.wxs" />
  </ItemGroup>

  <Target Name="TrazoArt" BeforeTargets="BeforeBuild" Inputs="@(TrazoArtInput)" Outputs="$(TrazoArtDir)TrazoArt.wxs">
    <RemoveDir Directories="$(TrazoArtDir)" />
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)art\InstallerArt.csproj&quot; -c Release -- &quot;$(TrazoArtDir.TrimEnd('\'))&quot;" />
  </Target>

  <!--
    Barra de título oscura del asistente: installer\titlebar (C#, .NET Framework 4.8) va dentro del .msi.
    Ver installer\README.md.
  -->
  <ItemGroup>
    <TrazoTitleBarInput Include="titlebar\*.cs;titlebar\*.csproj;..\Trazo.ico" />
  </ItemGroup>

  <Target Name="TrazoTitleBar" BeforeTargets="BeforeBuild" Inputs="@(TrazoTitleBarInput)" Outputs="$(TrazoTitleBarDir)TrazoTitleBar.exe">
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)titlebar\TrazoTitleBar.csproj&quot; -c Release -nologo -o &quot;$(TrazoTitleBarDir.TrimEnd('\'))&quot;" />
  </Target>

  <Target Name="PublishApp" BeforeTargets="BeforeBuild">
    <RemoveDir Directories="$(AppPublishDir)" />
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\Trazo.csproj&quot; -c Release -p:Version=$(AppVersion) -o &quot;$(AppPublishDir.TrimEnd('\'))&quot; -nologo" />
  </Target>

</Project>
